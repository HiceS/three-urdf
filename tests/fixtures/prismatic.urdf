<?xml version="1.0"?>
<robot name="prismatic_robot">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.3 0.3 0.05"/>
      </geometry>
    </visual>
  </link>

  <link name="slider_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>

  <joint name="slide_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="slider_link"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.5" effort="10" velocity="1"/>
  </joint>
</robot>
