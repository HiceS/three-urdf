<?xml version="1.0"?>
<robot name="primitives_robot">
  <material name="Red">
    <color rgba="1 0 0 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
      <material name="Red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
    </collision>
  </link>

  <link name="cylinder_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.4"/>
      </geometry>
      <material name="inline_blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>

  <link name="sphere_link">
    <visual>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
      <material name="semi_transparent">
        <color rgba="0 1 0 0.5"/>
      </material>
    </visual>
  </link>

  <link name="capsule_link">
    <visual>
      <geometry>
        <capsule radius="0.03" length="0.2"/>
      </geometry>
      <material name="Red"/>
    </visual>
  </link>

  <joint name="base_to_cylinder" type="revolute">
    <parent link="base_link"/>
    <child link="cylinder_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <joint name="cylinder_to_sphere" type="fixed">
    <parent link="cylinder_link"/>
    <child link="sphere_link"/>
    <origin xyz="0 0 0.4"/>
  </joint>

  <joint name="sphere_to_capsule" type="continuous">
    <parent link="sphere_link"/>
    <child link="capsule_link"/>
    <origin xyz="0.1 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
</robot>
